{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dayflaree/sourceweaver/schemas/analysis-report.schema.json",
  "title": "SourceWeaver analysis report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "encoding",
    "newline",
    "top_level_blocks",
    "diagnostics",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/fingerprint"
    },
    "encoding": {
      "type": "string"
    },
    "newline": {
      "enum": [
        "LF",
        "CRLF",
        "CR",
        "MIXED",
        "NONE"
      ]
    },
    "top_level_blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message",
        "evidence",
        "confidence",
        "object_refs"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "blocker"
          ]
        },
        "message": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "proven",
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "object_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
